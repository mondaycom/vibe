{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "ES2022.Intl", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/screens/*"],
      "@vibe/core/tokens": ["./node_modules/@vibe/core/dist/tokens/tokens.css"],
      "@vibe/core/next": ["../core/src/components/next.ts"],
      "@vibe/core": ["../core/src/index.ts"],
      "@vibe/icons": ["../icons/src/react/index.ts"],
      "@vibe/hooks": ["../hooks/src/index.ts"],
      "@vibe/shared": ["../shared/src/index.ts"],
      "@vibe/base": ["../base/src/index.ts"],
      "@vibe/button": ["../components/button/src/index.ts"],
      "@vibe/clickable": ["../components/clickable/src/index.ts"],
      "@vibe/dialog": ["../components/dialog/src/index.ts"],
      "@vibe/icon": ["../components/icon/src/index.ts"],
      "@vibe/icon-button": ["../components/icon-button/src/index.ts"],
      "@vibe/layer": ["../components/layer/src/index.ts"],
      "@vibe/layout": ["../components/layout/src/index.ts"],
      "@vibe/loader": ["../components/loader/src/index.ts"],
      "@vibe/tooltip": ["../components/tooltip/src/index.ts"],
      "@vibe/typography": ["../components/typography/src/index.ts"]
    }
  },
  "include": ["src"]
}
